+static int pid_still_alive(int pid,const char*pkg){
+ char path[256],comm[256];
+ snprintf(path,sizeof(path),"/proc/%d/cmdline",pid);
+ FILE*f=fopen(path,"r");if(!f)return 0;
+ size_t n=fread(comm,1,sizeof(comm)-1,f);fclose(f);if(n==0)return 0;
+ comm[n]=0;for(size_t i=0;i<n;i++)if(comm[i]==0)comm[i]=' ';
+ return strstr(comm,pkg)!=nullptr;
+}
+
+// Wait until the package has the same PID for settle_ms, or timeout.
+static int wait_stable_pid(const char*pkg,int timeout_ms,int settle_ms){
+ int stable_pid=-1,stable_for=0,elapsed=0;
+ while(elapsed<timeout_ms){
+  int pid=find_pid(pkg);
+  if(pid>0){
+   if(pid==stable_pid){
+    stable_for+=100;
+    if(stable_for>=settle_ms && pid_still_alive(pid,pkg)){
+     printf("DARKDEX_STABLE pid=%d settle_ms=%d elapsed_ms=%d\n",pid,settle_ms,elapsed);
+     return pid;
+    }
+   }else{
+    printf("DARKDEX_SEEN pid=%d elapsed_ms=%d\n",pid,elapsed);
+    stable_pid=pid;stable_for=0;
+   }
+  }else{
+   stable_pid=-1;stable_for=0;
+  }
+  usleep(100000);elapsed+=100;
+ }
+ if(stable_pid>0 && pid_still_alive(stable_pid,pkg)){
+  printf("DARKDEX_WARN using unstable pid=%d after timeout_ms=%d\n",stable_pid,timeout_ms);
+  return stable_pid;
+ }
+ return -1;
+}
