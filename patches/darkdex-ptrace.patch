+static int wait_stable_pid(const char*pkg,int timeout_ms,int settle_ms){
+ int stable_pid=-1,stable_for=0,elapsed=0;
+ while(elapsed<timeout_ms){
+  int pid=find_pid(pkg);
+  if(pid>0){
+   if(pid==stable_pid){
+    stable_for+=100;
+    if(stable_for>=settle_ms && pid_still_alive(pid,pkg)){
+     printf("DARKDEX_STABLE pid=%d settle_ms=%d elapsed_ms=%d\n",pid,settle_ms,elapsed);
+     return pid;
+    }
+   }else{
+    printf("DARKDEX_SEEN pid=%d elapsed_ms=%d\n",pid,elapsed);
+    stable_pid=pid;stable_for=0;
+   }
+  }else{
+   stable_pid=-1;stable_for=0;
+  }
+  usleep(100000);elapsed+=100;
+ }
+ if(stable_pid>0 && pid_still_alive(stable_pid,pkg)){
+  printf("DARKDEX_WARN using unstable pid=%d after timeout_ms=%d\n",stable_pid,timeout_ms);
+  return stable_pid;
+ }
+ return -1;
+}
+
+// Wait until maps show app code, with a hard ceiling so short-lived shells
+// still get scanned.
+static int wait_app_ready(int pid,const char*pkg,int timeout_ms){
+ int elapsed=0;
+ while(elapsed<timeout_ms){
+  if(!pid_still_alive(pid,pkg))return 0;
+  if(maps_look_ready(pid)){
+   // Extra decrypt window after app code appears.
+   int extra=0;
+   while(extra<4000){
+    if(!pid_still_alive(pid,pkg))return 0;
+    usleep(200000);extra+=200;
+   }
+   printf("DARKDEX_READY pid=%d ready_ms=%d extra_ms=%d\n",pid,elapsed,extra);
+   return 1;
+  }
+  usleep(200000);elapsed+=200;
+ }
+ printf("DARKDEX_WARN ready timeout pid=%d waited_ms=%d (scanning anyway)\n",pid,timeout_ms);
+ return pid_still_alive(pid,pkg);
+}
