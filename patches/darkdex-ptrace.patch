+static int attached_pid=-1;
+static void detach_target(){
+ if(attached_pid<=0)return;
+ if(ptrace(PTRACE_DETACH,attached_pid,nullptr,nullptr)<0){
+  int detach_errno=errno;
+  printf("DARKDEX_WARN ptrace detach failed errno=%d message=%s\n",detach_errno,strerror(detach_errno));
+ }else printf("DARKDEX_MEM ptrace_detached pid=%d\n",attached_pid);
+ attached_pid=-1;
+}
