+  for(int i=0;keys[i];i++)if(low.find(keys[i])!=std::string::npos)return 1;
+ }
+ for(auto&h:hosts){
+  std::string low=h;for(char&ch:low)ch=(char)tolower((unsigned char)ch);
+  if(low.find("ehome")!=std::string::npos||low.find("21cn")!=std::string::npos
+     ||low.find("smarthome")!=std::string::npos||low.find("189")!=std::string::npos)return 1;
+ }
+ for(auto&u:urls){
+  std::string low=u;for(char&ch:low)ch=(char)tolower((unsigned char)ch);
+  if(low.find("ehome")!=std::string::npos||low.find("21cn")!=std::string::npos
+     ||low.find("smarthome")!=std::string::npos)return 1;
+ }
+ return 0;
+}
