+static int open_target_memory(int pid){
+ char mp[256];snprintf(mp,sizeof(mp),"/proc/%d/mem",pid);
+ int fd=open(mp,O_RDONLY);if(fd>=0){printf("DARKDEX_MEM mode=direct\n");return fd;}
+ int direct_errno=errno;
+ printf("DARKDEX_MEM direct_open_failed errno=%d message=%s\n",direct_errno,strerror(direct_errno));
+ if(ptrace(PTRACE_ATTACH,pid,nullptr,nullptr)<0){
+  int attach_errno=errno;
+  printf("DARKDEX_ERR ptrace attach failed errno=%d message=%s\n",attach_errno,strerror(attach_errno));
+  return -1;
+ }
+ int status=0;
+ if(waitpid(pid,&status,0)<0||!WIFSTOPPED(status)){
+  int wait_errno=errno;
+  printf("DARKDEX_ERR ptrace wait failed errno=%d message=%s status=%d\n",wait_errno,strerror(wait_errno),status);
+  ptrace(PTRACE_DETACH,pid,nullptr,nullptr);
+  return -1;
+ }
+ fd=open(mp,O_RDONLY);int open_errno=errno;
+ if(fd<0){
+  printf("DARKDEX_ERR open mem after ptrace failed errno=%d message=%s\n",open_errno,strerror(open_errno));
+  ptrace(PTRACE_DETACH,pid,nullptr,nullptr);
+  return -1;
+ }
+ attached_pid=pid;
+ printf("DARKDEX_MEM mode=ptrace_attach target_frozen=1\n");
+ return fd;
+}
