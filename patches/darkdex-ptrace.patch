+static int pid_still_alive(int pid,const char*pkg){
+ char path[256],comm[256];
+ snprintf(path,sizeof(path),"/proc/%d/cmdline",pid);
+ FILE*f=fopen(path,"r");if(!f)return 0;
+ size_t n=fread(comm,1,sizeof(comm)-1,f);fclose(f);if(n==0)return 0;
+ comm[n]=0;for(size_t i=0;i<n;i++)if(comm[i]==0)comm[i]=' ';
+ return strstr(comm,pkg)!=nullptr;
+}
+
+// Skip framework/system mappings so WrapperInit / boot image DEXes are not
+// reported as application payloads. Anonymous maps are kept (packer decrypt).
+static int is_framework_map(const char*path){
+ if(!path||!path[0])return 0;
+ if(strstr(path,"/system/"))return 1;
+ if(strstr(path,"/apex/"))return 1;
+ if(strstr(path,"/vendor/"))return 1;
+ if(strstr(path,"/product/"))return 1;
+ if(strstr(path,"boot.art"))return 1;
+ if(strstr(path,"boot.oat"))return 1;
+ if(strstr(path,"boot-framework"))return 1;
+ if(strstr(path,"framework.jar"))return 1;
+ if(strstr(path,"/dev/ashmem/dalvik"))return 1;
+ return 0;
+}
+
+// True when the process has mapped the installed APK / native shell — i.e.
+// past pure Zygote WrapperInit class preload into real app code loading.
+static int maps_look_ready(int pid){
+ char mpath[256],line[1024];
+ snprintf(mpath,sizeof(mpath),"/proc/%d/maps",pid);
+ FILE*mf=fopen(mpath,"r");if(!mf)return 0;
+ int ready=0;
+ while(fgets(line,sizeof line,mf)){
+  if(strstr(line,"/data/app/")||strstr(line,"libexec")||strstr(line,"base.apk")){
+   ready=1;break;
+  }
+ }
+ fclose(mf);return ready;
+}
